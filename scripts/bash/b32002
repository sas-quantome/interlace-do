#!/bin/bash
#
# Description: Downloads a list of URLs using wget or curl.

# --- Input Validation ---
if [ -z "$1" ]; then
    echo "Usage: $0 <url_list_file.txt>"
    exit 1
fi

URL_FILE="$1"

if [ ! -f "$URL_FILE" ]; then
    echo "Error: File '$URL_FILE' not found!"
    exit 1
fi

# --- Dependency Check ---
if command -v wget >/dev/null 2>&1; then
    DOWNLOAD_TOOL="wget"
elif command -v curl >/dev/null 2>&1; then
    DOWNLOAD_TOOL="curl"
else
    echo "Error: Neither 'wget' nor 'curl' was found on this system."
    exit 1
fi

echo ">> Using '$DOWNLOAD_TOOL' to process the downloads..."
echo "---------------------------------------------------"

# Track total script execution time
TOTAL_START_TIME=$(date +%s)

# --- Download Loop ---
while IFS= read -r url || [ -n "$url" ]; do
    url=$(echo "$url" | xargs)

    if [[ -z "$url" || "$url" == \#* ]]; then
        continue
    fi

    echo "Downloading: $url"

    # Track individual download start time
    FILE_START_TIME=$(date +%s)

    # Execute the appropriate download command
    if [ "$DOWNLOAD_TOOL" == "wget" ]; then
        wget -c -q --show-progress "$url"
    else
        curl -O -J -L -# "$url"
    fi

    # Track individual download end time and calculate duration
    FILE_END_TIME=$(date +%s)
    FILE_DURATION=$((FILE_END_TIME - FILE_START_TIME))

    # Check if the download was successful
    if [ $? -eq 0 ]; then
        echo "[SUCCESS] Downloaded in ${FILE_DURATION} seconds: $url"
    else
        echo "[FAILED] Could not download: $url"
    fi
    echo "---------------------------------------------------"

done < "$URL_FILE"

# Track total end time and calculate overall duration
TOTAL_END_TIME=$(date +%s)
TOTAL_DURATION=$((TOTAL_END_TIME - TOTAL_START_TIME))

echo "All tasks completed in ${TOTAL_DURATION} seconds!"