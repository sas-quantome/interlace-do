# Bash script name: b32003
# Purpose: mock application made to test the Worker.
#
# Input: TSV file containing Timestamp, High and Low TAB delimited; created with b32001.
# Output: mean, median, and standard deviation.

set -o errexit

if [[ $# -ne 4 ]] ; then
    echo 'Number of parameters passed: '$#
    echo 'Usage: b32003 -f <FEATURE=[low|high]> -A <ARTIFACT_PATH>'
    exit 1
fi

exitFunction()
{
   echo 'Err: bad use of parameters'
   exit 1
}

while getopts "A:f:" opt
do
   case "$opt" in
      A ) ARTIFACT_PATH="$OPTARG" ;;
      f ) FEATURE="$OPTARG" ;;
      ? ) exitFunction ;;
   esac
done

if [ ! -e "$ARTIFACT_PATH" ]; then
  echo "Workspace path=[$ARTIFACT_PATH] does not exist."
  exit 1
fi

if [[ $FEATURE == "low" ]] ; then
  COLUMN_POS=3
  OUT="${ARTIFACT_PATH}/btc_low.tsv"
elif [[ $FEATURE == "high" ]] ; then
  COLUMN_POS=2
  OUT="${ARTIFACT_PATH}/btc_high.tsv"
else
  exitFunction
fi

# Sleep 2 or 3 seconds to mock a larger compute load
sleep $COLUMN_POS

# The following takes a fraction of a second
cut -f $COLUMN_POS "${ARTIFACT_PATH}/btc_refined.tsv" | python3 -c "import sys, statistics; data = [float(line) for line in sys.stdin]; print(f'Mean: {statistics.mean(data):.2f}, Median: {statistics.median(data):.2f}, Stdev: {statistics.stdev(data):.2f}')" > "$OUT"
