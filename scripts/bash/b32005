# Bash script name: b32005
# Purpose: mock application made to test the Worker.
#
# Input: TSV file containing Timestamp, High and Low TAB delimited; created with b32003.
# Output: rows matching the time pattern.

set -o errexit

if [[ $# -ne 6 ]] ; then
    echo 'Number of parameters passed: '$#
    echo 'Usage: b32003 -o <OUTPUT_FILE> -t <TIME_PATTERN> -A <ARTIFACT_PATH>'
    exit 1
fi

exitFunction()
{
   echo 'Err: bad use of parameters'
   exit 1
}

while getopts "A:o:t:" opt
do
   case "$opt" in
      A ) ARTIFACT_PATH="$OPTARG" ;;
      o ) OUTPUT_FILE="$OPTARG" ;;
      t ) TIME_PATTERN="$OPTARG" ;;
      ? ) exitFunction ;;
   esac
done

if [ ! -e "$ARTIFACT_PATH" ]; then
  echo "Workspace path=[$ARTIFACT_PATH] does not exist."
  exit 1
fi

grep "${TIME_PATTERN}" "${ARTIFACT_PATH}/btc_stats.txt" > "${ARTIFACT_PATH}/${OUTPUT_FILE}"
